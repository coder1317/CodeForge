# CodeForge V2 - Environment Variables
# Copy to .env and fill in the keys you want to use. All variables are optional;
# without keys, CodeForge uses local Ollama (if running) and the zero-key LLM7
# gateway as backup.

# ---- Cloud provider API keys (optional, any subset) ----
# Each key activates that provider in the pool. Set whichever you have.
GROQ_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
CHUTES_API_KEY=

# ---- LLM7.io (zero-key cloud gateway) ----
# Optional. Without a key, the free zero-key gateway is used. Set this to
# use your own LLM7 quota (sent as the Bearer token) instead.
LLM7_API_KEY=

# ---- Ollama (local inference) ----
# Optional. Defaults to http://localhost:11434. Useful if Ollama runs on
# another host or port. The pipeline auto-detects installed models and
# prefers small/fast ones (7B+ excluded by default).
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Server ----
# Port the CodeForge server listens on. Default: 3000
PORT=3000

# Comma-separated list of allowed CORS origins for the frontend.
# Defaults to http://localhost:3000 and http://127.0.0.1:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Build/Test agent ----
# Runs the REAL toolchain (npm install + build + optional test) on generated
# projects inside an isolated temp dir, then repairs failures via a
# Debugger -> Coder loop. Set to "off" to disable (pure generation). Default: on
# CODEFORGE_BUILD_AGENT=on

# Package manager used by the sandbox. Default: npm (set to "bun" for faster installs)
# CODEFORGE_PACKAGE_MANAGER=npm

# Timeouts (ms) for install and build/test commands. Defaults: 240000 / 180000
# CODEFORGE_INSTALL_TIMEOUT_MS=240000
# CODEFORGE_BUILD_TIMEOUT_MS=180000

# Keep the sandbox temp dir after a run for inspection (debugging only)
# CODEFORGE_KEEP_BUILD_DIR=0
